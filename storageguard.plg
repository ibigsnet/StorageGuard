<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "StorageGuard">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.09.28ab">
<!ENTITY launch "Settings/StorageGuard">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/StorageGuard/testing/storageguard.plg">
<!ENTITY github "ibigsnet/StorageGuard">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/StorageGuard/testing">
<!ENTITY plugdir "/usr/local/emhttp/plugins/StorageGuard">
<!ENTITY configdir "/boot/config/plugins/StorageGuard">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="shield"
  min="6.12.0"
  support="https://forums.unraid.net/topic/199796-plugin-storage-guard-free-space-thresholds-so-you-know-if-a-failed-disk-still-leaves-room-to-move-data/"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/testing/README.md">

<CHANGES>
###&version;
- Main free-bar colors load from the plugin's own page. Stock HeadInlineJS.php is no longer edited; upgrade and remove put it back. No more global jQuery .html() override.

###2026.09.28aa
- Pool math follows the BTRFS chunk allocator: correct usable space and Suggest values for mixed-size RAID1, RAID10, RAID1c3/c4 and RAID6. Alerts check refuses the request when the CSRF token cannot be read.

###2026.09.27aa
- Plugin payload is a flash .txz from the GitHub Release (not re-fetched from main at boot).

###2026.09.08ae–ag
- Suggest: no 2-disk RAID1 / sub-10G Δ. Settings Outline or fill for all targets. Docs/Help match tabs.

###2026.09.08ac–ad
- Settings tabs per Array and named pools; no empty parent tab; hide Array when no array disks.

###2026.09.08aa–ab
- Alerts check is POST+csrf; overlay install (do not wipe live plugin).

###2026.09.06aa–ab
- Hashed install (SHA256/MD5); Settings threshold note escapes form values.

### Older releases
- Full changelog: https://github.com/ibigsnet/StorageGuard/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "StorageGuard: preparing..."
# Note: do not delete /tmp/plugins/storageguard.plg here — Unraid install working copy
mkdir -p /boot/config/plugins/StorageGuard
rm -rf /usr/local/emhttp/plugins/storageguard 2>/dev/null || true
echo "StorageGuard: ready."
]]></INLINE>
</FILE>

<!-- raw-files begin -->
<FILE Name="&configdir;/StorageGuard-&version;-x86_64-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/ibigsnet/StorageGuard/releases/download/v&version;/StorageGuard-&version;-x86_64-1.txz</URL>
<SHA256>026f4e60f3f49093ec32972f515dcb7d96690de25234498672147f01985a22d6</SHA256>
<MD5>f1d9fe9d5a61ead777d01f330545f3ff</MD5>
</FILE>
<!-- raw-files end -->

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "StorageGuard: finishing install..."
if [ ! -f /usr/local/emhttp/plugins/StorageGuard/sg-lib.php ]; then
  echo "StorageGuard: ERROR — package did not install (missing sg-lib.php)"
  exit 1
fi
VER=""
for candidate in /tmp/plugins/storageguard.plg /boot/config/plugins/storageguard.plg; do
  if [ -f "$candidate" ]; then
    VER=$(sed -n 's/.*ENTITY version "\([^"]*\)".*/\1/p' "$candidate" | head -1)
    [ -n "$VER" ] && break
  fi
done
[ -z "$VER" ] && VER="unknown"
mkdir -p /boot/config/plugins/StorageGuard
if [ -n "$VER" ] && [ "$VER" != "unknown" ]; then
  find /boot/config/plugins/StorageGuard -maxdepth 1 -name 'StorageGuard-*-x86_64-1.txz' ! -name "StorageGuard-${VER}-x86_64-1.txz" -delete 2>/dev/null || true
fi
# Machine-aware product defaults (autofill disks, Yes toggles, green outline / no pulse)
php -r '
require_once "/usr/local/emhttp/plugins/StorageGuard/sg-lib.php";
$path = "/boot/config/plugins/StorageGuard/StorageGuard.cfg";
$fresh = !is_file($path);
if ($fresh && is_file("/usr/local/emhttp/plugins/StorageGuard/default.cfg")) {
  @copy("/usr/local/emhttp/plugins/StorageGuard/default.cfg", $path);
}
if (function_exists("sg_sync_pool_pages")) { sg_sync_pool_pages(); }
if (function_exists("sg_seed_product_cfg")) {
  // Fresh install: full seed. Upgrade: fill missing/empty threshold keys only.
  sg_seed_product_cfg($fresh);
  echo $fresh ? "StorageGuard: seeded product defaults on flash\n" : "StorageGuard: healed empty defaults on flash\n";
}
' 2>/dev/null || {
  if [ ! -f /boot/config/plugins/StorageGuard/StorageGuard.cfg ] \
     && [ -f /usr/local/emhttp/plugins/StorageGuard/default.cfg ]; then
    cp -a /usr/local/emhttp/plugins/StorageGuard/default.cfg /boot/config/plugins/StorageGuard/StorageGuard.cfg
  fi
}
chmod 755 /usr/local/emhttp/plugins/StorageGuard/scripts/* 2>/dev/null || true
# Main paint loads from StorageGuardHead.page. Older versions patched stock
# HeadInlineJS.php; put it back once.
/usr/local/emhttp/plugins/StorageGuard/scripts/sg-head-restore restore || true
echo "StorageGuard: packages now: $(ls /var/log/packages/StorageGuard-* 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
echo "StorageGuard: install complete. Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "StorageGuard: removing..."
# Put back stock HeadInlineJS.php if an older version patched it
if [ -x /usr/local/emhttp/plugins/StorageGuard/scripts/sg-head-restore ]; then
  /usr/local/emhttp/plugins/StorageGuard/scripts/sg-head-restore restore || true
fi
for p in /var/log/packages/StorageGuard-*; do
  [ -e "$p" ] || continue
  removepkg "$(basename "$p")" 2>/dev/null || true
done
rm -rf /usr/local/emhttp/plugins/StorageGuard
# Full uninstall: flash config + stock backups + runtime scratch (clean reinstall)
rm -rf /boot/config/plugins/StorageGuard
rm -rf /tmp/storageguard_alerts
rm -f /tmp/plugins/storageguard.txt 2>/dev/null || true
# Note: do not delete /tmp/plugins/storageguard.plg here — Unraid install working copy
# Note: do not touch /boot/config/plugins-removed/ (Unraid-owned)
# Note: does not touch user shares, /mnt, or folders named "Storage Guard"
echo "StorageGuard: removed."
]]></INLINE>
</FILE>

</PLUGIN>
