<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "StorageGuard">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.09.08af">
<!ENTITY launch "Settings/StorageGuard">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/StorageGuard/testing/storageguard.plg">
<!ENTITY github "ibigsnet/StorageGuard">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/StorageGuard/testing">
<!ENTITY plugdir "/usr/local/emhttp/plugins/StorageGuard">
<!ENTITY configdir "/boot/config/plugins/StorageGuard">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="shield"
  min="6.12.0"
  support="https://forums.unraid.net/topic/199796-plugin-storage-guard-free-space-thresholds-so-you-know-if-a-failed-disk-still-leaves-room-to-move-data/"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/testing/README.md">

<CHANGES>
###&version;
- Suggest: no 2-disk RAID1 / sub-10G Δ. Settings Outline or fill for all targets.

###2026.09.08ad
- No empty Storage Guard tab; hide Array when no array disks; Outline or fill on each storage tab.

###2026.09.08ac
- Settings tabs: Array, each pool by name, Settings, Help.

###2026.09.08aa–ab
- Alerts check is POST+csrf; overlay install (do not wipe live plugin).

###2026.09.06aa–ab
- Hashed raw install (SHA256/MD5); Settings threshold note escapes form values.

###2026.08.31aa
- RAID0/single/DUP/one-disk pools paint Critical (cannot survive a disk loss). Alerts once per level change, not hourly.

###2026.08.17ah–ab
- Array/Alerts/Cache order; Show Cache; pools-only HTML; Main-matching capacity labels.

### Older releases
- Full changelog: https://github.com/ibigsnet/StorageGuard/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "StorageGuard: preparing..."
# Note: do not delete /tmp/plugins/storageguard.plg here — Unraid install working copy
mkdir -p /boot/config/plugins/StorageGuard
# Forget old Slackware txz registration WITHOUT deleting the live tree.
# removepkg / rm -rf here ran before GitHub FILE copies; a failed download
# left Plugins on "error install".
for p in /var/log/packages/StorageGuard-*; do
  [ -e "$p" ] || continue
  echo "StorageGuard: forgetting old package $(basename "$p") (overlay files next)"
  rm -f "$p"
done
rm -rf /usr/local/emhttp/plugins/storageguard 2>/dev/null || true
rm -f /boot/config/plugins/StorageGuard/StorageGuard-*.txz 2>/dev/null || true
mkdir -p /usr/local/emhttp/plugins/StorageGuard
echo "StorageGuard: ready."
]]></INLINE>
</FILE>

