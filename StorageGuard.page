<?php
$plugin = "StorageGuard";
$cfg = parse_plugin_cfg($plugin);

// Pool capacity math (optional on partial installs)
if (is_file(__DIR__ . '/sg-lib.php')) {
  require_once __DIR__ . '/sg-lib.php';
}
if (is_file(__DIR__ . '/sg-pool-math.php')) {
  require_once __DIR__ . '/sg-pool-math.php';
}

// Load disk information from Unraid
$disks_ini = '/var/local/emhttp/disks.ini';
$has_disks = file_exists($disks_ini);
$disks = $has_disks ? parse_ini_file($disks_ini, true) : [];

// Format capacity KiB like Unraid Main Size. Shared helper in sg-lib.php.
function sg_format_size($kb) {
    if (function_exists('sg_format_size_kb')) {
        return sg_format_size_kb($kb);
    }
    if (!$kb || $kb <= 0) return '0';
    $value = (float)$kb * 1024.0;
    $kilo = 1000.0;
    $units = ['', 'K', 'M', 'G', 'T', 'P'];
    $base = $value > 0 ? (int)floor(log($value, $kilo)) : 0;
    if ($base > 5) $base = 5;
    if ($base < 0) $base = 0;
    $value /= pow($kilo, $base);
    // my_scale decimals=-1 (Main Size column)
    if ($value >= 100 || ((int)round($value * 10) % 10) === 0) $decimals = 0;
    else $decimals = 1;
    if (round($value, -1) == 1000 && $base < 5) { $value = 1; $base++; $decimals = 0; }
    $formatted = number_format($value, $decimals, '.', '');
    if (strpos($formatted, '.') !== false) {
        $formatted = rtrim(rtrim($formatted, '0'), '.');
    }
    return $units[$base] === '' ? $formatted : ($formatted . $units[$base]);
}

/** disks.ini capacity KiB matching Main (fsSize / size / sectors). */
function sg_page_disk_kb($d) {
    if (function_exists('sg_disk_capacity_kb')) {
        return sg_disk_capacity_kb($d);
    }
    $fs = isset($d['fsSize']) ? (int)$d['fsSize'] : 0;
    if ($fs > 0) return $fs;
    return isset($d['size']) ? (int)$d['size'] : 0;
}

// Get current BTRFS profile for a pool (e.g. RAID10, RAID1, RAID5)
function get_btrfs_profile($pool) {
    $mount = "/mnt/" . $pool;
    if (!is_dir($mount)) {
        return "unknown (not mounted?)";
    }
    $cmd = "btrfs fi df " . escapeshellarg($mount) . " 2>/dev/null";
    $output = @shell_exec($cmd);
    if ($output && preg_match('/Data,\s*(\S+):/i', $output, $m)) {
        return $m[1];
    }
    // Fallback to usage for more detail
    $cmd2 = "btrfs fi usage " . escapeshellarg($mount) . " 2>/dev/null | grep -E 'Data,|Metadata,' | head -2";
    $output2 = @shell_exec($cmd2);
    if ($output2) {
        return trim(preg_replace('/\s+/', ' ', $output2));
    }
    return "unknown";
}

function get_btrfs_devices($pool) {
    $mount = "/mnt/" . $pool;
    if (!is_dir($mount)) return [];
    $cmd = "btrfs fi show " . escapeshellarg($mount) . " 2>/dev/null | grep -E 'devid|Size:'";
    $output = @shell_exec($cmd);
    return $output ? "see btrfs fi show" : [];
}

// Simple helper to get list of device sizes for a pool from our collected data
function get_pool_devices_summary($sizes) {
    if (empty($sizes)) return "no devices detected";
    return implode(', ', $sizes);
}

// Unraid naming: pool slots are cache, cache2, mypool, mypool2, ...
function sg_pool_prefix($key) {
    return preg_replace('/\d+$/', '', $key);
}

/** Display name: cache → Cache (first letter upper). */
function sg_pool_title($name) {
    $name = (string)$name;
    if ($name === '') return $name;
    return strtoupper($name[0]) . substr($name, 1);
}

// Sort human size strings largest-first (26T > 8T > 500G)
function sg_sort_sizes_desc($sizes) {
    $sizes = array_values(array_unique($sizes));
    usort($sizes, function($a, $b) {
        $va = (float)preg_replace('/[^0-9.]/', '', $a);
        $ua = (strpos($a, 'T') !== false) ? 1000 : ((strpos($a, 'G') !== false) ? 1 : 0.001);
        $vb = (float)preg_replace('/[^0-9.]/', '', $b);
        $ub = (strpos($b, 'T') !== false) ? 1000 : ((strpos($b, 'G') !== false) ? 1 : 0.001);
        return ($vb * $ub) <=> ($va * $ua);
    });
    return $sizes;
}

/** outline (default) | solid — prefer per-target key, fall back to legacy global color_style */
function sg_resolve_style($cfg, $key) {
    $legacy = $cfg['color_style'] ?? 'outline';
    $s = $cfg[$key] ?? $legacy;
    return ($s === 'solid') ? 'solid' : 'outline';
}

// Collect array data disk capacities (unique, largest first). Ignore parity / boot / cache.
$array_sizes = [];
$array_raw_sizes = [];
if ($has_disks) {
    foreach ($disks as $key => $d) {
        if (empty($d['device'])) continue;
        $type = isset($d['type']) ? $d['type'] : '';
        $name = isset($d['name']) ? $d['name'] : $key;
        $is_data = ($type === 'Data') || preg_match('/^disk\d+$/', $name) || preg_match('/^disk\d+$/', $key);
        if (!$is_data) continue;
        $sz = sg_page_disk_kb($d);
        if ($sz > 0) {
            $array_raw_sizes[] = $sz;
            $array_sizes[] = sg_format_size($sz);
        }
    }
}
$array_sizes = sg_sort_sizes_desc($array_sizes);

// Collect pools: only type=Cache, grouped by pool name (prefix of slot key).
$pools = [];
$pools_raw = [];
if ($has_disks) {
    foreach ($disks as $key => $d) {
        if (empty($d['device'])) continue;
        $type = isset($d['type']) ? $d['type'] : '';
        if ($type !== 'Cache') continue;
        $status = isset($d['status']) ? $d['status'] : '';
        if (strpos($status, '_NP') !== false) continue;
        $poolName = sg_pool_prefix($key);
        if ($poolName === '' || $poolName === 'flash') continue;
        $sz = sg_page_disk_kb($d);
        if ($sz > 0) {
            if (!isset($pools[$poolName])) $pools[$poolName] = [];
            $pools[$poolName][] = sg_format_size($sz);
            if (!isset($pools_raw[$poolName])) $pools_raw[$poolName] = [];
            $pools_raw[$poolName][] = $sz;
        }
    }
}
foreach ($pools as $pname => $sizes) {
    $pools[$pname] = sg_sort_sizes_desc($sizes);
}
ksort($pools, SORT_NATURAL | SORT_FLAG_CASE);
$pool_names = array_keys($pools);

// Dev/preview only when no disks.ini (not Unraid). Real installs always use live pool names.
if (!$has_disks || (empty($array_sizes) && empty($pools))) {
  $array_sizes = ['26T', '12T', '8T', '4T', '2T'];
  $pools = ['cache' => ['2T', '2T']];
  $pool_names = ['cache'];
  $pools_raw = ['cache' => [2000000000, 2000000000]];
  $dev_mode = true;
} else {
  $dev_mode = false;
}

// Array defaults: Warning = largest data disk; Critical = smallest data disk
$array_defaults = ['warning' => '', 'critical' => ''];
if (!empty($array_raw_sizes)) {
    $sorted = $array_raw_sizes;
    rsort($sorted, SORT_NUMERIC);
    $array_defaults = [
        'warning' => sg_format_size($sorted[0]),
        'critical' => sg_format_size($sorted[count($sorted) - 1]),
    ];
} elseif (!$has_disks && !empty($array_sizes)) {
    // $array_sizes is unique largest-first; last entry is smallest unique size
    $array_defaults = [
        'warning' => $array_sizes[0],
        'critical' => $array_sizes[count($array_sizes) - 1],
    ];
}

// Pool defaults: Warning = None; Critical = None (user opts in per pool)
$pool_defaults = [];
foreach ($pools_raw as $pname => $raws) {
    $pool_defaults[$pname] = ['warning' => '', 'critical' => ''];
}

// Build <option>s; include leading "None" (empty value = no threshold for that level)
function sg_size_options($sizes, $current, $include_none = true) {
    $html = '';
    if ($include_none) {
        $sel = ($current === '' || $current === null) ? ' selected' : '';
        $html .= '<option value=""' . $sel . '>None</option>';
    }
    $found = ($current === '' || $current === null);
    foreach ($sizes as $s) {
        $sel = ($s === $current) ? ' selected' : '';
        if ($sel) $found = true;
        $html .= '<option value="' . htmlspecialchars($s) . '"' . $sel . '>' . htmlspecialchars($s) . '</option>';
    }
    if (!$found && $current !== '' && $current !== null) {
        $html .= '<option value="' . htmlspecialchars($current) . '" selected>' . htmlspecialchars($current) . '</option>';
    }
    if (empty($sizes) && !$include_none) {
        $html = '<option value="">No disks detected</option>';
    }
    return $html;
}

$array_use_custom = $cfg['array_use_custom'] ?? 'no';
$array_warning_custom = $cfg['array_warning_custom'] ?? '';
$array_critical_custom = $cfg['array_critical_custom'] ?? '';

// Product defaults locked once user Applies with sg_defaults=1 (hidden field).
// Until then: fix first-run / broken cfgs (empty array warning, pool alerts on, etc.).
$sg_defaults_ok = (($cfg['sg_defaults'] ?? '') === '1');
$has_array_disks = !empty($array_raw_sizes);

// Array Warning: largest data disk until user has saved defaults (or explicitly set a size / None after seed)
if ($sg_defaults_ok && array_key_exists('array_warning', $cfg)) {
    $array_warning = $cfg['array_warning'];
    // Legacy binary labels (e.g. 23.6T) → SI matching Main (e.g. 25.9T)
    if ($array_use_custom !== 'yes' && $array_warning !== '' && function_exists('sg_migrate_disk_size_label')) {
        $array_warning = sg_migrate_disk_size_label($array_warning, $array_raw_sizes);
    }
    if ($array_use_custom !== 'yes' && $array_warning !== '' && !empty($array_sizes) && !in_array($array_warning, $array_sizes, true)) {
        $array_warning = $array_defaults['warning'] ?? '';
    }
} else {
    // Unseeded / first open: largest data disk when array exists
    $array_warning = $has_array_disks ? ($array_defaults['warning'] ?? '') : '';
}

// Critical: smallest data disk (same evacuate model; equal disks → same as Warning)
if ($sg_defaults_ok && array_key_exists('array_critical', $cfg)) {
    $array_critical = $cfg['array_critical'];
    if ($array_use_custom !== 'yes' && $array_critical !== '' && function_exists('sg_migrate_disk_size_label')) {
        $array_critical = sg_migrate_disk_size_label($array_critical, $array_raw_sizes);
    }
    if ($array_use_custom !== 'yes' && $array_critical !== '' && !empty($array_sizes) && !in_array($array_critical, $array_sizes, true)) {
        $array_critical = $array_defaults['critical'] ?? '';
    }
} else {
    $array_critical = $has_array_disks ? ($array_defaults['critical'] ?? '') : '';
}

// Array coloring: product default Yes only when array data disks exist.
// Pools-only / no-array first open → No (section is hidden; paint inactive).
if ($sg_defaults_ok && isset($cfg['array_coloring'])) {
    $array_coloring = (($cfg['array_coloring'] ?? '') === 'yes') ? 'yes' : 'no';
} else {
    $array_coloring = $has_array_disks ? 'yes' : 'no';
}
// First open / missing keys: product defaults (pool paint on; green OK; pulse off)
$pool_coloring = $cfg['pool_coloring'] ?? $cfg['cache_coloring'] ?? 'yes';
if ($pool_coloring !== 'yes') {
    $pool_coloring = 'no';
}
$array_color_style = sg_resolve_style($cfg, 'array_color_style');
$outline_pulse = (($cfg['outline_pulse'] ?? 'no') === 'yes') ? 'yes' : 'no';
$outline_show_ok = (($cfg['outline_show_ok'] ?? 'yes') === 'yes') ? 'yes' : 'no';

$pools_to_color = $cfg['pools_to_color'] ?? 'all';  // 'all' or comma list

// --- Alerts: product default = Array Warning + Critical (when array exists). All pool alerts off. ---
if ($sg_defaults_ok && isset($cfg['alerts_array_warning'])) {
    $alerts_array_warning = $cfg['alerts_array_warning'];
} else {
    $alerts_array_warning = $has_array_disks ? 'yes' : 'no';
}

if ($sg_defaults_ok && isset($cfg['alerts_array_critical'])) {
    $alerts_array_critical = $cfg['alerts_array_critical'];
} else {
    $alerts_array_critical = $has_array_disks ? 'yes' : 'no';
}

// No array: never seed array alerts on (even if an old cfg had them checked).
// After user Applies with sg_defaults=1 they can still opt in via Show hidden items.
if (!$has_array_disks && !$sg_defaults_ok) {
    $alerts_array_warning = 'no';
    $alerts_array_critical = 'no';
}

$pool_alert_cfg = [];
foreach ($pool_names as $p) {
    $safe = preg_replace('/[^a-zA-Z0-9_]/', '_', $p);
    $wk = "alerts_pool_{$safe}_warning";
    $ck = "alerts_pool_{$safe}_critical";
    // Until defaults are seeded, never show pool alerts as on
    if ($sg_defaults_ok && isset($cfg[$wk])) {
        $pw = $cfg[$wk];
    } else {
        $pw = 'no';
    }
    if ($sg_defaults_ok && isset($cfg[$ck])) {
        $pc = $cfg[$ck];
    } else {
        $pc = 'no';
    }
    $pool_alert_cfg[$p] = [
        'safe' => $safe,
        'warning' => $pw,
        'critical' => $pc,
    ];
}
?>

